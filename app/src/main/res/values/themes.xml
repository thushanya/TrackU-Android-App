<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Sea Coral colors -->
    <style name="Base.Theme.Labexam3" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors - Ocean Blue -->
        <item name="colorPrimary">@color/ocean_blue</item>
        <item name="colorPrimaryVariant">@color/ocean_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary colors - Coral -->
        <item name="colorSecondary">@color/coral</item>
        <item name="colorSecondaryVariant">@color/coral_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/ocean_blue_light</item>
        <item name="colorOnSurface">@color/deep_sea</item>
        
        <!-- Accent color -->
        <item name="colorAccent">@color/sea_foam</item>
    </style>

    <style name="Theme.Labexam3" parent="Base.Theme.Labexam3" />
</resources>